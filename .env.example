# OpenRouter LLM Configuration
# Get your API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Verified Free Tier Models:
# - inclusionai/ling-3.0-flash-sante:free (Default · Ultra-Fast)
# - nvidia/nemotron-3.5-lightning:free (High Precision)
# - nvidia/nemotron-3-ultra-550b-a55b:free (Deep Reasoning)
# - google/gemma-4-31b-it:free (Google Gemma Free)
# - qwen/qwen3.8-27b:free (Qwen Free)
# - openrouter/free (Auto-Free Router)
OPENROUTER_MODEL=inclusionai/ling-3.0-flash-sante:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# TypeSafe AI (Jev System One Safety Guard)
# Get your API key at: https://console.typesafe.ai/
TYPESAFE_API_KEY=your_typesafe_api_key_here

# TimescaleDB / PostgreSQL Database Settings
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=building_db
DATABASE_URL=postgresql://postgres:postgres@db:5432/building_db

# Service Ports & Host
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=8501

# System Anchors & Timezone
DEFAULT_TIMEZONE=Asia/Bangkok

# Observability & Tracing (Pydantic Logfire)
LOGFIRE_TOKEN=your_logfire_token_here
LOGFIRE_SERVICE_NAME=alto-tech-ai-engineer
